# Copy to .env (gitignored). Used by scripts/build_db.py and scripts/embed_hadith.py
# via python-dotenv + the OpenAI client (reads OPENAI_API_KEY).

OPENAI_API_KEY=

# Optional: absolute path to hadith.db for the MCP server (overrides config.yml).
# HADITH_MCP_DB_PATH=/path/to/hadith.db

# MCP semantic search (must match embedding dimensions in hadith.db; default matches this repo).
# HADITH_MCP_QUERY_EMBEDDING_MODEL=text-embedding-3-large

# Per-client semantic search cap (requests per rolling minute). 0 / off / empty = unlimited.
# HADITH_MCP_RATE_LIMIT_SEARCH_RPM=60

# LRU entries for repeated identical semantic queries (0 = disable).
# HADITH_MCP_SEARCH_CACHE_MAX=256
